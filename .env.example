# Credenciais do Postgres local (docker compose).
# Se alterar usuário, senha, banco ou porta, mantenha DATABASE_URL alinhada.
POSTGRES_USER=solano
POSTGRES_PASSWORD=solano
POSTGRES_DB=solano
POSTGRES_PORT=5432

# Driver assíncrono usado pela API e pelo Alembic.
DATABASE_URL=postgresql+asyncpg://solano:solano@localhost:5432/solano

# Token do bot no Telegram (@BotFather) e o segredo que valida o header
# X-Telegram-Bot-Api-Secret-Token no webhook. Sem eles, a polling/webhook não sobe.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Chave da Anthropic para o agente responder com Claude. Sem chave, o Solano usa
# o formatador de fallback (determinístico, baseado em palavra-chave).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Token exigido no header X-Admin-Token para revisar sugestões em /admin/*.
# Sem valor, a API de admin responde 503 (desligada).
ADMIN_TOKEN=
